NODE_ENV=development
PORT=5000
# Frontend origin(s) allowed by CORS, comma-separated
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb://localhost:27017/acme_homes
# Leave empty (or point at a Redis that isn't running) in development and the API
# falls back to an in-memory store. Required in production. Upstash: rediss://default:<pw>@<host>:6379
REDIS_URL=redis://localhost:6379

# Two different random values. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production while these contain "change-me".
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Refresh-token cookie. "lax" when the frontend and API share a site
# (acmehomes.com + api.acmehomes.com, or the frontend proxies /api).
# "none" only if they're on different sites (needs HTTPS; Safari may still block it).
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.acmehomes.com

# Cloudinary (photo storage). Find these on your Cloudinary dashboard.
# Leave empty in development to save photos to the local uploads/ folder.
# Set all three in production — most hosts wipe their disk on every deploy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=acme-homes

# Seed admin (used by `bun run seed`)
SEED_ADMIN_EMAIL=admin@acmehomes.com
SEED_ADMIN_PASSWORD=Admin@12345
